# ==============================================================================
# PLATFORMIO (Compilação e Ferramentas)
# ==============================================================================
# Ignora toda a pasta .pio (onde ficam bibliotecas baixadas, arquivos .o, .elf e .bin)
# Essa pasta tem mais de 200MB e é recriada automaticamente pelo "pio run"
.pio/
.pioenvs/
.piolibdeps/

# ==============================================================================
# VS CODE (Configurações Locais e Temporárias)
# ==============================================================================
# Índices de autocomplete do C/C++ e histórico de depuração
.vscode/.browse.c_cpp.db*
.vscode/c_cpp_properties.json
.vscode/launch.json
.vscode/ipch/
.vscode/*.log

# ==============================================================================
# SISTEMA OPERACIONAL (macOS e Windows)
# ==============================================================================
# Arquivos que o Finder do Mac cria automaticamente em cada pasta
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes

# Arquivos do Windows (caso algum colega use Windows)
Thumbs.db
ehthumbs.db
desktop.ini

# ==============================================================================
# BACKUPS E TEMPORÁRIOS
# ==============================================================================
*.bak
*.tmp
*.swp
*~

# ==============================================================================
# SEGURANÇA E CREDENCIAIS (Opcional, boas práticas)
# ==============================================================================
# Se você um dia isolar as senhas do Wi-Fi e Token do Telegram em um arquivo separado
secrets.h
.env